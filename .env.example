# Optional public settings for the Waterloo LEARN fork.
# Sign in and complete Duo in the browser; do not put passwords or MFA secrets here.
# D2L_USERNAME=your_waterloo_username
# D2L_SESSION_DIR=~/.d2l-session
# D2L_TOKEN_TTL=3600
# D2L_INCLUDE_COURSES=123456,789012
# D2L_EXCLUDE_COURSES=111111,222222
# D2L_ACTIVE_ONLY=true
