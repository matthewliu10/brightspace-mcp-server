{
  "name": "waterloo-learn-mcp",
  "version": "2.0.0",
  "description": "Local read-only MCP server for University of Waterloo LEARN (Brightspace), with visible Waterloo login and Duo.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "brightspace-mcp-server": "build/index.js",
    "brightspace-auth": "build/auth-cli.js",
    "brightspace-setup": "build/setup.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "start": "node build/index.js",
    "auth": "node build/auth-cli.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "npx playwright install chromium",
    "setup": "node build/setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/keyring": "^2.0.0",
    "ajv": "^8.18.0",
    "dotenv": "^17.2.4",
    "file-type": "^21.3.0",
    "playwright": "^1.58.2",
    "sanitize-filename": "^1.6.3",
    "trash": "^10.1.1",
    "turndown": "^7.2.2",
    "unpdf": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-filename": "^1.1.28",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "Rohan Muppa",
  "homepage": "https://github.com/matthewliu10/brightspace-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthewliu10/brightspace-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/matthewliu10/brightspace-mcp-server/issues"
  },
  "keywords": [
    "waterloo",
    "learn",
    "brightspace",
    "mcp",
    "duo"
  ],
  "private": true
}
